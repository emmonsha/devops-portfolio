# -*- mode: ruby -*-
# vi: set ft=ruby :

# Configuration for k3s cluster - optimized for 12 CPU / 16GB RAM host with 35GB total disk space
nodes = [
  { :hostname => 'k3s-master', :ip => '192.168.77.10', :ram => 3072, :cpus => 2 },  # Master node with more resources
  { :hostname => 'k3s-worker1', :ip => '192.168.77.11', :ram => 2048, :cpus => 1 }, # Worker node
  { :hostname => 'k3s-worker2', :ip => '192.168.77.12', :ram => 2048, :cpus => 1 }  # Worker node
]

Vagrant.configure("2") do |config|
  config.hostmanager.enabled = true
  config.hostmanager.manage_host = true
  config.hostmanager.manage_guest = true
  config.hostmanager.ignore_private_ip = false
  config.hostmanager.include_offline = false
  config.ssh.forward_agent = true
  config.vm.box = "hashicorp-education/ubuntu-24-04"
  config.vm.box_version = "0.1.0"

  nodes.each do |node|
    config.vm.define node[:hostname] do |node_config|
      node_config.vm.hostname = node[:hostname]
      node_config.vm.network :private_network, ip: node[:ip]

      memory = node[:ram] || 2048
      cpus = node[:cpus] || 1

      node_config.vm.provider :virtualbox do |vb|
        vb.customize [
          "modifyvm", :id,
          "--memory", memory.to_s,
          "--cpus", cpus.to_s
        ]
      end

      # Install prerequisites
      node_config.vm.provision :shell, inline: <<-SHELL
      sudo apt update
      sudo apt install -y curl wget vim bash-completion
      SHELL
      
      # General synced folders for project access
      node_config.vm.synced_folder ".", "/vagrant"
      node_config.vm.synced_folder "../src", "/home/vagrant/project"

      if node[:hostname] == "k3s-master"
        # Port forwarding for Kubernetes dashboard and services
        node_config.vm.network "forwarded_port", guest: 6443, host: 6443  # Kubernetes API
        node_config.vm.network "forwarded_port", guest: 80, host: 8080     # Ingress HTTP
        node_config.vm.network "forwarded_port", guest: 443, host: 8443    # Ingress HTTPS
        node_config.vm.network "forwarded_port", guest: 3000, host: 3000   # Grafana (if monitoring is deployed)
        node_config.vm.network "forwarded_port", guest: 9090, host: 9090   # Prometheus (if monitoring is deployed)
        
        # Configure disk size for master node (15GB out of 35GB total allocation)
        node_config.disksize.size = '15GB'

        # Master node setup
        node_config.vm.provision "shell", privileged: false, inline: <<-SHELL
          sudo timedatectl set-ntp true
          sleep 3
        SHELL
      end

      if node[:hostname].start_with?("k3s-worker")
        # Configure disk size for worker nodes (10GB each out of 35GB total allocation)
        node_config.disksize.size = '10GB'
        
        # Worker node setup
        node_config.vm.provision "shell", privileged: false, inline: <<-SHELL
          sudo timedatectl set-ntp true
          sleep 3
        SHELL
      end
    end
  end
end